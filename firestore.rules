rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Quem é quem
    // ------------------------------------------------------------------
    function logado() { return request.auth != null; }

    // Mestre: só estes dois e-mails exatos.
    function mestre() {
      return logado()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@beyonddepths.com', 'mestre@beyonddepths.com'];
    }

    // Dono do documento que já existe.
    function dono() { return logado() && resource.data.ownerId == request.auth.uid; }

    // Quem cria precisa se declarar dono (a pessoa não cria ficha no nome de outra).
    function criaComoDono() {
      return logado()
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId == request.auth.uid;
    }

    // Quem não é mestre não pode passar o documento para outra pessoa.
    function mantemDono() {
      return mestre() || request.resource.data.ownerId == resource.data.ownerId;
    }

    // ------------------------------------------------------------------
    // Limites de tamanho e de tipo (travam lixo, spam e documentos gigantes)
    // ------------------------------------------------------------------
    function texto(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    function lista(d, campo, max) {
      return !(campo in d) || (d[campo] is list && d[campo].size() <= max);
    }
    function mapa(d, campo, max) {
      return !(campo in d) || (d[campo] is map && d[campo].keys().size() <= max);
    }

    // Ficha do personagem.
    function fichaOk(d) {
      return d.keys().size() <= 120
        && texto(d, 'nome', 120)
        && texto(d, 'jogador', 120)
        && texto(d, 'conceito', 300)
        && texto(d, 'retrato', 2000)
        && texto(d, 'ownerName', 120)
        && texto(d, 'embedCor', 9)
        && texto(d, 'embedFoto', 20)
        && texto(d, 'embedSimbolo', 8)
        && texto(d, 'embedRodape', 120)
        && texto(d, 'historia', 20000)
        && texto(d, 'notas', 20000)
        && texto(d, 'lacunas', 20000)
        && lista(d, 'habilidades', 500)
        && lista(d, 'habilidadesEquipadas', 50)
        && lista(d, 'pictosPossuidos', 500)
        && lista(d, 'pictosEquipados', 50)
        && lista(d, 'inventario', 500) && lista(d, 'armasPossuidas', 200)
        && lista(d, 'ecos', 200)
        && mapa(d, 'status', 40)
        && mapa(d, 'ampolas', 20)
        && mapa(d, 'dominio', 100);
    }

    // Habilidade.
    function habilidadeOk(d) {
      return d.keys().size() <= 80
        && texto(d, 'nome', 120)
        && texto(d, 'descricao', 5000)
        && texto(d, 'perfeita', 2000)
        && texto(d, 'origem', 300)
        && texto(d, 'ownerName', 120)
        && lista(d, 'porPerfeicao', 50)
        && lista(d, 'tags', 50);
    }

    // Itens da biblioteca do mestre (picto, arma, item, monstro).
    function bibliotecaOk(d) {
      return d.keys().size() <= 120
        && texto(d, 'nome', 120)
        && texto(d, 'descricao', 8000)
        && texto(d, 'imagem', 2000)
        && lista(d, 'tags', 50);
    }

    // Arma: os mesmos limites da biblioteca, mais o teto de Poder e de Quebra do site.
    function armaOk(d) {
      return bibliotecaOk(d)
        && texto(d, 'origem', 300)
        && texto(d, 'ownerName', 120)
        && lista(d, 'passivas', 20)
        && (!('poder' in d) || (d.poder is number && d.poder >= 0 && d.poder <= 60))
        && (!('quebra' in d) || (d.quebra is number && d.quebra >= 0 && d.quebra <= 2));
    }

    // Ampolas da expedição: um registro único ('atual'), compartilhado por todos.
    function ampolaOk(a) {
      return a is map && a.keys().hasOnly(['atual', 'max'])
        && a.atual is int && a.max is int
        && a.atual >= 0 && a.atual <= a.max && a.max <= 20;
    }
    function expedicaoOk(d) {
      return d.keys().hasOnly(['id', 'ampolas', 'fragmentos', 'updatedAt'])
        && d.id == 'atual'
        && d.fragmentos is int && d.fragmentos >= 0 && d.fragmentos <= 999
        && d.ampolas is map && d.ampolas.keys().hasOnly(['cura', 'lumia', 'retorno'])
        && ampolaOk(d.ampolas.cura) && ampolaOk(d.ampolas.lumia) && ampolaOk(d.ampolas.retorno);
    }
    function maxPadrao(d) {
      return d.ampolas.cura.max == 3 && d.ampolas.lumia.max == 2 && d.ampolas.retorno.max == 1;
    }
    function maxIgual(d, r) {
      return d.ampolas.cura.max == r.ampolas.cura.max
        && d.ampolas.lumia.max == r.ampolas.lumia.max
        && d.ampolas.retorno.max == r.ampolas.retorno.max;
    }

    // ------------------------------------------------------------------
    // Fichas: quem está logado lê; cada jogador mexe só na sua; o mestre em todas.
    // ------------------------------------------------------------------
    match /lumia_personagens/{id} {
      allow read: if logado();
      allow create: if (criaComoDono() || mestre()) && fichaOk(request.resource.data) && id.size() <= 80;
      allow update: if (dono() || mestre()) && mantemDono() && fichaOk(request.resource.data);
      allow delete: if dono() || mestre();
    }

    // Habilidades: jogadores criam as suas; o mestre edita todas.
    match /lumia_habilidades/{id} {
      allow read: if logado();
      allow create: if (criaComoDono() || mestre()) && habilidadeOk(request.resource.data) && id.size() <= 80;
      allow update: if (dono() || mestre()) && mantemDono() && habilidadeOk(request.resource.data);
      allow delete: if dono() || mestre();
    }

    // Biblioteca do mestre: todos leem, só o mestre escreve (pictos, itens e monstros).
    match /lumia_pictos/{id} {
      allow read: if logado();
      allow create, update: if mestre() && bibliotecaOk(request.resource.data);
      allow delete: if mestre();
    }
    // Armas: qualquer pessoa logada cria as suas e mexe só nelas; o mestre mexe em todas.
    match /lumia_armas/{id} {
      allow read: if logado();
      allow create: if (criaComoDono() || mestre()) && armaOk(request.resource.data) && id.size() <= 80;
      allow update: if (dono() || mestre()) && mantemDono() && armaOk(request.resource.data);
      allow delete: if dono() || mestre();
    }
    // Ampolas da expedição: qualquer pessoa logada gasta e recupera cargas e mexe nos
    // Fragmentos; só o mestre muda a carga máxima (o que os Fragmentos compram) e apaga o registro.
    match /lumia_expedicao/{id} {
      allow read: if logado();
      allow create: if logado() && id == 'atual' && expedicaoOk(request.resource.data)
        && (mestre() || maxPadrao(request.resource.data));
      allow update: if logado() && expedicaoOk(request.resource.data)
        && (mestre() || maxIgual(request.resource.data, resource.data));
      allow delete: if mestre();
    }
    match /lumia_itens/{id} {
      allow read: if logado();
      allow create, update: if mestre() && bibliotecaOk(request.resource.data);
      allow delete: if mestre();
    }
    match /lumia_monstros/{id} {
      allow read: if logado();
      allow create, update: if mestre() && bibliotecaOk(request.resource.data);
      allow delete: if mestre();
    }

    // ------------------------------------------------------------------
    // Painel antigo (pasta legacy/): só leitura para quem está logado.
    // Só o mestre escreve. Antes, qualquer pessoa logada apagava tudo daqui.
    // ------------------------------------------------------------------
    match /characters/{id}         { allow read: if logado(); allow write: if mestre(); }
    match /monsters/{id}           { allow read: if logado(); allow write: if mestre(); }
    match /global_skills/{id}      { allow read: if logado(); allow write: if mestre(); }
    match /global_weapons/{id}     { allow read: if logado(); allow write: if mestre(); }
    match /global_armors/{id}      { allow read: if logado(); allow write: if mestre(); }
    match /global_accessories/{id} { allow read: if logado(); allow write: if mestre(); }

    // ------------------------------------------------------------------
    // Égide (site novo): coleções egide_*
    // ------------------------------------------------------------------
    // Campos que só a mestragem muda: nível, bônus, treino, Ascensão e a aprovação.
    function camposDaMestragemIguais(d, r) {
      let k = d.diff(r).affectedKeys();
      return !k.hasAny(['nivel', 'bonus', 'ptTreino', 'ascensao', 'bonusPV', 'aprovada', 'salario', 'boosts', 'inicialFixo'])
        && (!k.hasAny(['nsfw']) || d.get('nsfw', {}).get('bonusPS', 0) == r.get('nsfw', {}).get('bonusPS', 0))
        && (!k.hasAny(['campanha']) || campanhaOk(d, r))
        && (!k.hasAny(['novaEgide']) || d.get('novaEgide', false) == false);
    }
    // Campanha: só a mestragem mexe. Fichas antigas (sem campanha) podem ganhar a campanha vazia que o site cria sozinho.
    function campanhaOk(d, r) {
      return !('campanha' in r) && d.get('campanha', {}) == {'reputacao': 0, 'patrulhas': 0, 'vinculos': [], 'contatos': [], 'pistas': [], 'consequencias': [], 'missoes': []};
    }
    // Treino: cada treino conta +1 em treino.n, com 12 horas (menos uma folga) desde o anterior, e rende no máximo 3 PT.
    // Fora de um treino, Marcas e PT de treino não mudam. Cada 1 PP trocado custa 2 PT de treino.
    function treinoOk(d, r) {
      // O treino é anotado só pela mestragem.
      return !d.diff(r).affectedKeys().hasAny(['treino']);
    }
    // Dinheiro: o jogador só gasta (gastoTotal sobe) e recebe o salário uma vez por semana.
    // Ganho da semana: salário + Patrocínio do boost (heróis e anti-heróis).
    function semanal(r) {
      return r.get('salario', 0) + (r.get('alinhamento', 'heroi') == 'vilao' ? 0 : (r.get('boosts', 0) == 2 ? 250 : (r.get('boosts', 0) == 1 ? 125 : 0)));
    }
    function dinheiroOk(d, r) {
      return !d.diff(r).affectedKeys().hasAny(['creditos', 'gastoTotal', 'semanaSalario']) || dinheiroMudouOk(d, r);
    }
    function dinheiroMudouOk(d, r) {
      return (r.get('aprovada', false) == true
          || (d.get('gastoTotal', 0) == r.get('gastoTotal', 0) && d.get('creditos', 0) == r.get('creditos', 0)))
        && d.get('gastoTotal', 0) >= r.get('gastoTotal', 0)
        && (d.get('creditos', 0) == r.get('creditos', 0)
          || (d.get('semanaSalario', '') != r.get('semanaSalario', '')
            && semanal(r) > 0
            && d.get('creditos', 0) > r.get('creditos', 0)
            && d.get('creditos', 0) <= r.get('creditos', 0) + semanal(r) * 8
            && (d.get('creditos', 0) - r.get('creditos', 0)) % semanal(r) == 0));
    }
    // Ficha nova de jogador: nível 1, sem bônus, sem aprovação.
    function fichaNovaLimpa(d) {
      return d.get('nivel', 1) == 1
        && d.get('aprovada', false) == false
        && d.get('ptTreino', 0) == 0
        && d.get('ascensao', 0) == 0
        && d.get('bonusPV', 0) == 0
        && d.get('treino', {}).get('ptGanho', 0) == 0 && d.get('treino', {}).get('trocas', 0) == 0
        && d.get('creditos', 0) == 0 && d.get('salario', 0) == 0 && d.get('inicialFixo', null) == null
        && (d.get('bonus', null) == null || d.bonus == {'pt': 0, 'pp': 0, 'det': 0})
        && d.get('novaEgide', false) == false
        && d.get('campanha', {}).get('patrulhas', 0) == 0 && d.get('campanha', {}).get('reputacao', 0) == 0;
    }
    // Depois da aprovação, o jogador só soma: não tira poder, feitiço, qualidade, defeito ou aumento, nem baixa atributo ou perícia.
    function evolucaoSoSobe(d, r) {
      let k = d.diff(r).affectedKeys();
      return r.get('aprovada', false) != true
        || !k.hasAny(['poderes', 'grimorio', 'qualidades', 'defeitos', 'aumentos', 'atributos'])
        || evolucaoDetalhe(d, r, k);
    }
    function evolucaoDetalhe(d, r, k) {
      return (!k.hasAny(['poderes']) || d.get('poderes', []).size() >= r.get('poderes', []).size())
        && (!k.hasAny(['grimorio']) || d.get('grimorio', []).size() >= r.get('grimorio', []).size())
        && (!k.hasAny(['qualidades']) || d.get('qualidades', []).hasAll(r.get('qualidades', [])))
        && (!k.hasAny(['defeitos']) || d.get('defeitos', []) == r.get('defeitos', []))
        && (!k.hasAny(['aumentos']) || d.get('aumentos', []).hasAll(r.get('aumentos', [])))
        && (!k.hasAny(['atributos']) || atributosSoSobem(d.get('atributos', {}), r.get('atributos', {})));
    }
    // Perícias: o site já trava a perícia que desce e o log de Alterações mostra tudo.
    // Comparar as 43 perícias uma a uma estourava o limite de 1000 expressões do Firebase.
    function atributosSoSobem(n, o) {
      return n.get('FOR', 0) >= o.get('FOR', 0) && n.get('AGI', 0) >= o.get('AGI', 0) && n.get('VIG', 0) >= o.get('VIG', 0)
        && n.get('INT', 0) >= o.get('INT', 0) && n.get('VON', 0) >= o.get('VON', 0) && n.get('PRE', 0) >= o.get('PRE', 0);
    }
    // Depois da aprovação, Origem e Potencial ficam travados para o jogador.
    function potencialTravado(d, r) {
      return r.get('aprovada', false) != true
        || (d.get('origem', '') == r.get('origem', '') && d.get('potencial', null) == r.get('potencial', null) && d.get('feNoDestino', false) == r.get('feNoDestino', false));
    }
    function textosEgideOk(d) {
      return texto(d, 'nome', 120) && texto(d, 'codinome', 120) && texto(d, 'conceito', 400)
        && texto(d, 'simbolo', 16) && texto(d, 'retrato', 400000) && texto(d, 'ownerName', 120)
        && texto(d, 'historia', 20000) && texto(d, 'aparencia', 5000) && texto(d, 'notas', 20000) && texto(d, 'perda', 5000);
    }
    function listasEgideOk(d) {
      return lista(d, 'poderes', 60) && lista(d, 'grimorio', 80) && lista(d, 'inventario', 300) && lista(d, 'compras', 80) && lista(d, 'extrato', 80)
        && lista(d, 'fraquezas', 10) && lista(d, 'qualidades', 30) && lista(d, 'defeitos', 5);
    }
    function mapasEgideOk(d) {
      return mapa(d, 'adulto', 5) && mapa(d, 'nsfw', 12) && (!('nsfw' in d) || d.nsfw.get('galeria', []).size() <= 8)
        && texto(d.get('adulto', {}), 'fetiches', 3000) && texto(d.get('adulto', {}), 'limites', 3000)
        && mapa(d, 'campanha', 7) && mapa(d, 'atributos', 6) && mapa(d, 'pericias', 60) && mapa(d, 'estilos', 20) && mapa(d, 'kits', 6);
    }
    // Ficha nova: confere tudo.
    function fichaEgideOk(d) {
      return d.keys().size() <= 80 && textosEgideOk(d) && listasEgideOk(d) && mapasEgideOk(d);
    }
    // Edição: confere só o grupo de campos que mudou (a ficha inteira custava centenas de expressões a cada clique).
    function fichaEgideMudouOk(d, r) {
      let k = d.diff(r).affectedKeys();
      return d.keys().size() <= 80
        && (!k.hasAny(['nome', 'codinome', 'conceito', 'simbolo', 'retrato', 'ownerName', 'historia', 'aparencia', 'notas', 'perda']) || textosEgideOk(d))
        && (!k.hasAny(['poderes', 'grimorio', 'inventario', 'compras', 'extrato', 'fraquezas', 'qualidades', 'defeitos']) || listasEgideOk(d))
        && (!k.hasAny(['adulto', 'nsfw', 'campanha', 'atributos', 'pericias', 'estilos', 'kits']) || mapasEgideOk(d));
    }
    function poderEgideOk(d) {
      return d.keys().size() <= 40
        && texto(d, 'nome', 120) && texto(d, 'descritor', 2000) && texto(d, 'notas', 2000) && texto(d, 'ownerName', 120)
        && lista(d, 'extras', 20) && lista(d, 'falhas', 15) && lista(d, 'variacoes', 12)
        && (!('grau' in d) || (d.grau is number && d.grau >= 1 && d.grau <= 8));
    }

    // O bot do Discord (conta bot@beyonddepths.com) anota o treino que ele mesmo rolou com `!treino`.
    // Só mexe em treino, Fadiga e PV, conta exatamente 1 treino e rende no máximo 3 PT.
    function botDoDiscord() {
      return request.auth != null && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'bot@beyonddepths.com';
    }
    function soTreinoDoBot(d, r) {
      let k = d.diff(r).affectedKeys();
      let tn = d.get('treino', {});
      let to = r.get('treino', {});
      return k.hasOnly(['treino', 'medidores', 'updatedAt'])
        && tn is map && tn.get('n', 0) == to.get('n', 0) + 1
        && tn.get('ptGanho', 0) <= to.get('ptGanho', 0) + 3
        && (!k.hasAny(['medidores']) || (d.medidores is map
          && d.medidores.diff(r.get('medidores', {})).affectedKeys().hasOnly(['fadiga', 'pv'])));
    }
    match /egide_personagens/{id} {
      allow read: if logado();
      allow create: if id.size() <= 80 && fichaEgideOk(request.resource.data)
        && (mestre() || (criaComoDono() && fichaNovaLimpa(request.resource.data)));
      allow update: if fichaEgideMudouOk(request.resource.data, resource.data)
        && (mestre()
          || (dono() && mantemDono()
            && camposDaMestragemIguais(request.resource.data, resource.data)
            && potencialTravado(request.resource.data, resource.data)
            && evolucaoSoSobe(request.resource.data, resource.data)
            && dinheiroOk(request.resource.data, resource.data)
            && treinoOk(request.resource.data, resource.data))
          || (botDoDiscord() && soTreinoDoBot(request.resource.data, resource.data)));
      allow delete: if dono() || mestre();
    }
    // Configuração da mesa (perguntas da aba NSFW): todos leem, só a mestragem escreve.
    match /egide_config/{id} {
      allow read: if logado();
      allow write: if mestre();
    }
    // Log de alterações das fichas: todos leem; cada um grava as próprias entradas; ninguém edita (só a mestragem apaga).
    match /egide_alteracoes/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.quemUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['id', 'fichaId', 'ficha', 'quem', 'quemUid', 'quando', 'mudancas'])
        && request.resource.data.mudancas is list && request.resource.data.mudancas.size() <= 25
        && texto(request.resource.data, 'ficha', 120) && texto(request.resource.data, 'quem', 120) && id.size() <= 80;
      allow update: if false;
      allow delete: if mestre();
    }
    // Biblioteca de poderes: todos leem; cada jogador mexe nos seus.
    match /egide_poderes/{id} {
      allow read: if logado();
      allow create: if (criaComoDono() || mestre()) && poderEgideOk(request.resource.data) && id.size() <= 80;
      allow update: if (dono() || mestre()) && mantemDono() && poderEgideOk(request.resource.data);
      allow delete: if dono() || mestre();
    }
    // Catálogo do Arsenal: todos leem, só a mestragem escreve.
    match /egide_itens/{id} {
      allow read: if logado();
      allow create, update: if mestre() && bibliotecaOk(request.resource.data);
      allow delete: if mestre();
    }

    // Todo o resto fica negado: nenhuma coleção nova nasce aberta.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
